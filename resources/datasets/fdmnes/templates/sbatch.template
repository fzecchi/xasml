#!/bin/zsh -l
#SBATCH --nodes=1
#SBATCH --ntasks-per-node={ncpus}
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=16G
#SBATCH --time=120:00:00
#SBATCH --partition=nice,nice-long
#SBATCH --constraint="hpc5"
#SBATCH --job-name="job"
#SBATCH --output=%x_out.txt
#SBATCH --error=%x_out.txt

function compress {{
    gzip -f job_bav.txt
}}

# Load the FDMNES module.
module load fdmnes/{version}

# Run the calculation.
srun apptainer run ${{FDMNES_IMAGE}}

# Compress the large job_bav.txt file.
compress
